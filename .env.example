# —— 大模型配置（OpenAI 兼容协议）——
# 不填 API Key 时，系统自动启用「本地规则引擎」兜底（仍可正常运行、可用于演示），
# 但评委看到的"真实 AI 能力"需要在下方配置一个可用的 Key。
#
# 推荐：DeepSeek（便宜、中文强、OpenAI 兼容）
#   注册 https://platform.deepseek.com 获取 API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
#
# 也可换成 OpenAI / 通义 / 智谱 等任意 OpenAI 兼容端点，例如：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# —— 服务配置 ——
PORT=3000
# 单次检索召回的法条/规则数量
TOP_K=6
